<div id="player" class="player-container" data-controller="history player genre-filter">
  <div id="loading" class="loading-state hidden" data-player-target="loading">Loading...</div>
  <div id="error-message" class="error-message hidden" data-player-target="error"></div>

  <div class="filter-panel">
    <div class="genre-filter-bar">
      <% DiscogsService.genres.each do |genre| %>
        <button
          type="button"
          class="genre-tag"
          data-genre="<%= genre %>"
          data-genre-filter-target="tag"
          data-action="click->genre-filter#toggle"
        >
          <%= genre %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="deck-panel">
    <div class="video-wrapper">
      <iframe
        data-player-target="iframe"
        width="560"
        height="315"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </div>

  <div class="display-panel">
    <div class="track-info">
      <h2 data-player-target="title">Loading...</h2>
      <p data-player-target="artist"></p>
    </div>
  </div>

  <div class="control-panel">
    <div class="controls">
      <button data-player-target="prevButton" data-action="click->player#previousTrack" class="control-button" disabled>Previous Song</button>
      <button data-player-target="nextButton" data-action="click->player#nextTrack" class="control-button">Next Random Song</button>
    </div>
  </div>
</div>
